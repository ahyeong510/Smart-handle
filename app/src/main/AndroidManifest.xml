<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ✅ 필수 권한 선언 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ✅ Android 12 이상용 블루투스 권한 -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartHandle">

        <activity android:name=".maps.MapsActivity" />
        <activity android:name=".mapselect.SelectLocationActivity" />

        <activity android:name=".mapselect.SelectLocationActivity" />

        <!-- ✅ 구글 지도 API 키 -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyCW5MXLusoUzLSFiZGdirbZv7V2h6Zazw0" />

        <!-- ✅ 앱 실행 시 제일 먼저 뜨는 화면 -->
        <activity
            android:name=".ui.start.StartActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartHandle">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ✅ 권한 설정 화면 -->
        <activity
            android:name=".ui.permission.PermissionActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartHandle" />

        <!-- ✅ 메인 탭 화면 -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartHandle" />

        <!-- ✅ 주행 지도 화면 (DrivingActivity) -->
        <activity
            android:name=".ui.driving.DrivingActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SmartHandle" />
    </application>

</manifest>
