<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <fragment
        android:id="@+id/drive_map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/turnCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF">

        <ImageView
            android:id="@+id/turnIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_turn_left" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/turnDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0m 후"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000" />

            <TextView
                android:id="@+id/turnTypeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="좌회전"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#000000" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btn_test_tts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TTS 테스트"
        android:layout_above="@id/btn_stop_route"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_stop_route"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="주행 종료"
        android:textColor="@android:color/white"
        android:backgroundTint="#000000"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp" />

</RelativeLayout>