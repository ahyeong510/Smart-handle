<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".ui.permission.PermissionActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 제목 -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="권한 설정"
            android:textColor="#1E1E2D"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 설명 -->
        <TextView
            android:id="@+id/tvDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Bike Navi를 사용하기 위해 다음 권한이 필요합니다"
            android:textColor="#666666"
            android:textSize="14sp" />

        <!-- 위치 권한 카드 -->
        <LinearLayout
            android:id="@+id/sectionLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="16dp"
            android:orientation="vertical"
            android:background="#F7F7F7"
            android:elevation="2dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvLocationTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="위치 권한"
                android:textColor="#1E1E2D"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLocationDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="실시간 경로 안내를 위해 위치 정보가 필요합니다"
                android:textColor="#666666"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnAllowLocation"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="권한 허용"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:backgroundTint="#0D0D0D" />
        </LinearLayout>

        <!-- 블루투스 권한 카드 -->
        <LinearLayout
            android:id="@+id/sectionBluetooth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:orientation="vertical"
            android:background="#F7F7F7"
            android:elevation="2dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvBtTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="블루투스 권한"
                android:textColor="#1E1E2D"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBtDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="ESP32 디바이스와 연결하여 햅틱 피드백을 전송합니다"
                android:textColor="#666666"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnAllowBluetooth"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="권한 허용"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:backgroundTint="#0D0D0D" />
        </LinearLayout>

        <!-- 완료 버튼 -->
        <Button
            android:id="@+id/btnDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:layout_marginHorizontal="24dp"
            android:backgroundTint="#000000"
            android:text="완료"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:enabled="false"
            android:alpha="0.4"
            android:fontFamily="sans-serif-medium">

        </Button>
    </LinearLayout>
</ScrollView>
